+// "Block not available (pruned data)" from getblock
+func isBlockPruned(err *bchain.RPCError) bool {
+	return err.Code == -1 && strings.HasPrefix(err.Message, "Block not available") && !strings.Contains(err.Message, "not fully downloaded")
