+	r, err := b.getRawTransactionFromBlock(txid, blockHash)
+	if err == errBlockPruned {
+		err = b.refetchBlock(blockHash, func() bool {
+			_, err := b.getRawTransactionFromBlock(txid, blockHash)
+			return err != errBlockPruned
+		})
+		if err == nil {
+			r, err = b.getRawTransactionFromBlock(txid, blockHash)
+		}
+	}
