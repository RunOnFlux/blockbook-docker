+func TestPrunedTxFromBlockOnDisk(t *testing.T) {
+	f := &fakePrunedNode{peers: twoPeers}
+	tx, err := newFakePrunedRPC(f, true).GetTransaction(prunedTxid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkPrunedTx(t, tx)
+	if f.calls("getpeerinfo") != 0 || f.calls("getblockfrompeer") != 0 {
+		t.Fatalf("a block on disk must not be downloaded, calls %v", f.methods)
+	}
+}
