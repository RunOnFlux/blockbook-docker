+)
+
+// fakePrunedNode answers like Bitcoin Core 31 run with prune=1 and without
+// txindex. The block is pruned until a peer sends it, arriveAfter after
+// getblockfrompeer if sends is set.
+type fakePrunedNode struct {
+	mu          sync.Mutex
+	pruned      bool
+	peers       string
+	sends       bool
+	arriveAfter time.Duration
+	requested   []int
+	methods     []string
+}
+
+func (f *fakePrunedNode) handle(body string) string {
+	var req struct {
+		Method string          `json:"method"`
+		Params json.RawMessage `json:"params"`
+	}
+	if err := json.Unmarshal([]byte(body), &req); err != nil {
+		return `{"result":null,"error":{"code":-32700,"message":"Parse error"},"id":1}`
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.methods = append(f.methods, req.Method)
+	switch req.Method {
+	case "getrawtransaction":
+		var p struct {
+			Txid      string `json:"txid"`
+			Blockhash string `json:"blockhash"`
+		}
+		_ = json.Unmarshal(req.Params, &p)
+		if p.Blockhash == "" {
+			return `{"result":null,"error":{"code":-5,"message":"No such mempool transaction. Use -txindex or provide a block hash to enable blockchain transaction queries. Use gettransaction for wallet transactions."},"id":1}`
+		}
+		if f.pruned {
+			return `{"result":null,"error":{"code":-1,"message":"Block not available"},"id":1}`
+		}
+		if p.Txid != prunedTxid {
+			return `{"result":null,"error":{"code":-5,"message":"No such transaction found in the provided block. Use gettransaction for wallet transactions."},"id":1}`
+		}
+		return `{"result":` + prunedTxRaw + `,"error":null,"id":1}`
+	case "getblock":
+		var p struct {
+			Verbosity int `json:"verbosity"`
+		}
+		_ = json.Unmarshal(req.Params, &p)
+		if f.pruned {
+			return `{"result":null,"error":{"code":-1,"message":"Block not available (pruned data)"},"id":1}`
+		}
+		if p.Verbosity == 0 {
+			return `{"result":"00","error":null,"id":1}`
+		}
+		return `{"result":{"hash":"` + prunedBlock + `","height":5,"tx":["` + prunedTxid + `"]},"error":null,"id":1}`
+	case "getpeerinfo":
+		return `{"result":` + f.peers + `,"error":null,"id":1}`
+	case "getblockfrompeer":
+		var p struct {
+			PeerID int `json:"peer_id"`
+		}
+		_ = json.Unmarshal(req.Params, &p)
+		if !f.pruned {
+			return `{"result":null,"error":{"code":-1,"message":"Block already downloaded"},"id":1}`
+		}
+		f.requested = append(f.requested, p.PeerID)
+		if f.sends {
+			time.AfterFunc(f.arriveAfter, func() {
+				f.mu.Lock()
+				f.pruned = false
+				f.mu.Unlock()
+			})
+		}
+		return `{"result":{},"error":null,"id":1}`
+	}
+	return `{"result":null,"error":{"code":-32601,"message":"Method not found"},"id":1}`
+}
+
+func (f *fakePrunedNode) calls(method string) int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	n := 0
+	for _, m := range f.methods {
+		if m == method {
+			n++
+		}
+	}
+	return n
+}
+
+// newFakePrunedRPC wires a BitcoinRPC to f; the index places prunedTxid in
+// prunedBlock and knows no other transaction
+func newFakePrunedRPC(f *fakePrunedNode, pruned bool) *BitcoinRPC {
+	cfg := &Configuration{}
+	transport := roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		body, _ := io.ReadAll(r.Body)
+		return &http.Response{
+			StatusCode: 200,
+			Body:       io.NopCloser(strings.NewReader(f.handle(string(body)))),
+			Header:     http.Header{"Content-Type": []string{"application/json"}},
+		}, nil
+	})
+	b := &BitcoinRPC{
+		BaseChain:    &bchain.BaseChain{Parser: NewBitcoinParser(GetChainParams("main"), cfg)},
+		client:       http.Client{Transport: transport},
+		rpcURL:       "http://backend",
+		ChainConfig:  cfg,
+		RPCMarshaler: JSONMarshalerV2{},
+	}
+	if pruned {
+		b.SetPrunedBackend(func(txid string) (string, error) {
+			if txid == prunedTxid {
+				return prunedBlock, nil
+			}
+			return "", nil
+		})
+	}
+	return b
+}
+
+func checkPrunedTx(t *testing.T, tx *bchain.Tx) {
+	t.Helper()
+	if tx.Txid != prunedTxid || tx.VSize != 110 || tx.Hex == "" || tx.Confirmations != 10 || tx.Blocktime != 1700000000 || tx.Version != 2 {
+		t.Fatalf("unexpected tx %+v", tx)
+	}
+	if len(tx.Vin) != 1 || tx.Vin[0].Txid == "" || tx.Vin[0].Vout != 1 || tx.Vin[0].Sequence != 4294967293 {
+		t.Fatalf("unexpected vin %+v", tx.Vin)
+	}
+}
