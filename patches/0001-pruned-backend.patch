+// refetchPrunedBlock downloads again a block that a getblock call was refused
+// because the node had pruned it, and reports whether to repeat the call
+func (b *BitcoinRPC) refetchPrunedBlock(blockHash string, rpcErr *bchain.RPCError) bool {
+	if b.txBlock == nil || !isBlockPruned(rpcErr) {
+		return false
+	}
+	if err := b.refetchBlock(blockHash, func() bool { return b.blockStored(blockHash) }); err != nil {
+		glog.Warning("rpc: ", err)
+		return false
+	}
+	return true
+}
+
+// blockStored reports whether the node has the block's data
+func (b *BitcoinRPC) blockStored(blockHash string) bool {
+	res := ResGetBlockInfo{}
+	req := CmdGetBlock{Method: "getblock"}
+	req.Params.BlockHash = blockHash
+	req.Params.Verbosity = 1
+	return b.Call(&req, &res) == nil && res.Error == nil
+}
+
+// refetchBlock downloads a pruned block again; arrived reports whether the
+// node has stored it. Concurrent requests for one block share one download.
+func (b *BitcoinRPC) refetchBlock(blockHash string, arrived func() bool) error {
+	_, err, _ := b.blockFetches.Do(blockHash, func() (interface{}, error) {
+		return nil, b.fetchBlockFromPeers(blockHash, arrived)
+	})
+	return err
+}
+
+func (b *BitcoinRPC) fetchBlockFromPeers(blockHash string, arrived func() bool) error {
+	select {
+	case b.blockFetchSlots <- struct{}{}:
+		defer func() { <-b.blockFetchSlots }()
+	case <-time.After(blockFetchQueueTimeout):
+		return errors.Errorf("block %v is pruned and %d downloads are already running", blockHash, maxBlockFetches)
+	}
+	peers, err := b.archivalPeers()
+	if err != nil {
+		return errors.Annotatef(err, "block %v is pruned", blockHash)
+	}
+	for i, id := range peers {
+		if i == blockFromPeerAttempts {
+			break
+		}
+		glog.V(1).Info("rpc: getblockfrompeer ", blockHash, " peer ", id)
+		res := ResGetBlockFromPeer{}
+		req := CmdGetBlockFromPeer{Method: "getblockfrompeer"}
+		req.Params.Blockhash = blockHash
+		req.Params.PeerID = id
+		if err := b.Call(&req, &res); err != nil {
+			return errors.Annotatef(err, "getblockfrompeer %v", blockHash)
+		}
+		if res.Error != nil {
+			// another request stored it meanwhile
+			if strings.Contains(res.Error.Message, "already downloaded") {
+				return nil
+			}
+			glog.Warning("rpc: getblockfrompeer ", blockHash, " peer ", id, ": ", res.Error)
+			continue
+		}
+		for deadline := time.Now().Add(blockFromPeerTimeout); time.Now().Before(deadline); {
+			time.Sleep(100 * time.Millisecond)
+			if arrived() {
+				return nil
+			}
+		}
+		glog.Warning("rpc: getblockfrompeer ", blockHash, " peer ", id, ": no block in ", blockFromPeerTimeout)
+	}
+	return errors.Errorf("block %v is pruned and no peer sent it", blockHash)
+}
+
+// archivalPeers returns the connected peers that serve every block (NODE_NETWORK,
+// not only the last 288 blocks of NODE_NETWORK_LIMITED), in random order
+func (b *BitcoinRPC) archivalPeers() ([]int, error) {
+	res := ResGetPeerInfo{}
+	if err := b.Call(&CmdGetPeerInfo{Method: "getpeerinfo"}, &res); err != nil {
+		return nil, errors.Annotatef(err, "getpeerinfo")
+	}
+	if res.Error != nil {
+		return nil, errors.Annotatef(res.Error, "getpeerinfo")
+	}
+	var peers []int
+	for _, p := range res.Result {
+		if slices.Contains(p.ServicesNames, "NETWORK") && slices.Contains(p.ServicesNames, "WITNESS") {
+			peers = append(peers, p.ID)
+		}
+	}
+	if len(peers) == 0 {
+		return nil, errors.New("no connected peer serves old blocks")
+	}
+	rand.Shuffle(len(peers), func(i, j int) { peers[i], peers[j] = peers[j], peers[i] })
+	return peers, nil
+}
