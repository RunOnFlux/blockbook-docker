+// At most maxBlockFetches pruned blocks are downloaded at once, which bounds
+// the bandwidth and tx cache growth that requests for old transactions cause;
+// a request that waits longer than blockFetchQueueTimeout for its turn fails.
+const maxBlockFetches = 8
