+func TestPrunedBlockDownloadsAreBounded(t *testing.T) {
+	saved := blockFetchQueueTimeout
+	blockFetchQueueTimeout = 100 * time.Millisecond
+	defer func() { blockFetchQueueTimeout = saved }()
+	f := &fakePrunedNode{peers: twoPeers, pruned: true, sends: true}
+	b := newFakePrunedRPC(f, true)
