+
+// prefetchParallelism bounds the transactions of one history page fetched at once
+const prefetchParallelism = 8
+
+// Prefetch puts the given transactions into the cache concurrently. With a
+// pruned backend an old transaction may need its block from a peer, and a
+// history page would otherwise wait for those downloads one after another.
+func (c *TxCache) Prefetch(txids []string) {
+	if !c.enabled || !c.db.PrunedBackend() || len(txids) < 2 {
+		return
+	}
+	sem := make(chan struct{}, prefetchParallelism)
+	var wg sync.WaitGroup
+	for _, txid := range txids {
+		wg.Add(1)
+		sem <- struct{}{}
+		go func(txid string) {
+			defer func() {
+				<-sem
+				wg.Done()
+			}()
+			if _, _, err := c.GetTransaction(txid); err != nil {
+				glog.V(1).Info("txcache: prefetch ", txid, ": ", err)
+			}
+		}(txid)
+	}
+	wg.Wait()
+}
