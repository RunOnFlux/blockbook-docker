+// SetPrunedBackend tells that the node is pruned and runs without -txindex, so
+// it can return a confirmed transaction only from its block: txBlock returns
+// the hash of that block from blockbook's index. A block the node has pruned
+// is downloaded again from a peer (getblockfrompeer, Bitcoin Core 24+) and
+// kept by the node until it prunes again.
+func (b *BitcoinRPC) SetPrunedBackend(txBlock func(txid string) (string, error)) {
+	b.txBlock = txBlock
+	b.blockFetchSlots = make(chan struct{}, maxBlockFetches)
