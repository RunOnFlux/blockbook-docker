diff --git a/bchain/mq_shutdown_test.go b/bchain/mq_shutdown_test.go
new file mode 100644
index 00000000..70e6529f
--- /dev/null
+++ b/bchain/mq_shutdown_test.go
@@ -0,0 +1,80 @@
+package bchain
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	zmq "github.com/pebbe/zmq4"
+)
+
+// Shutdown used to unsubscribe and close the socket while run() waited in
+// RecvMessageBytes on it, which libzmq does not allow: it returned an error
+// (the socket was never bound) and now and then aborted the whole process.
+// Shut down repeatedly, right after a notification and while idle.
+func TestMQShutdown(t *testing.T) {
+	subs := SubscriptionTopics{BlockSubscribe: "hashblock", BlockReceive: "hashblock", TxSubscribe: "hashtx", TxReceive: "hashtx"}
+	for i := 0; i < 40; i++ {
+		pubCtx, err := zmq.NewContext()
+		if err != nil {
+			t.Fatal(err)
+		}
+		pub, err := pubCtx.NewSocket(zmq.PUB)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := pub.SetLinger(0); err != nil {
+			t.Fatal(err)
+		}
+		if err := pub.Bind("tcp://127.0.0.1:*"); err != nil {
+			t.Fatal(err)
+		}
+		endpoint, err := pub.GetLastEndpoint()
+		if err != nil {
+			t.Fatal(err)
+		}
+		got := make(chan NotificationType, 1)
+		mq, err := NewMQ(endpoint, nil, func(nt NotificationType) {
+			select {
+			case got <- nt:
+			default:
+			}
+		}, subs)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i%2 == 0 {
+			// a PUB socket drops messages until the subscription has reached it
+			deadline := time.After(10 * time.Second)
+			for delivered := false; !delivered; {
+				if _, err := pub.SendMessage("hashblock", []byte{1}, []byte{0, 0, 0, 0}); err != nil {
+					t.Fatal(err)
+				}
+				select {
+				case nt := <-got:
+					if nt != NotificationNewBlock {
+						t.Fatalf("iteration %d: notification %v, want NotificationNewBlock", i, nt)
+					}
+					delivered = true
+				case <-time.After(20 * time.Millisecond):
+				case <-deadline:
+					t.Fatalf("iteration %d: no notification", i)
+				}
+			}
+		} else {
+			// run() is blocked in RecvMessageBytes
+			time.Sleep(20 * time.Millisecond)
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		err = mq.Shutdown(ctx)
+		cancel()
+		if err != nil {
+			t.Fatalf("iteration %d: Shutdown: %v", i, err)
+		}
+		if mq.isRunning {
+			t.Fatalf("iteration %d: the receive loop is still running", i)
+		}
+		pub.Close()
+		pubCtx.Term()
+	}
+}
